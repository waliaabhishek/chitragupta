# HTTPS endpoint and bearer token for the Iceberg REST catalog.
ICEBERG_CATALOG_URI=https://iceberg.example.test/catalog
ICEBERG_CATALOG_TOKEN=

# Confluent Cloud API key with access to inventory and billing.
CCLOUD_API_KEY=
CCLOUD_API_SECRET=

# Prometheus endpoints reachable from the worker.
KAFKA_PROMETHEUS_URL=http://localhost:9090
GENERIC_PROMETHEUS_URL=http://localhost:9090
